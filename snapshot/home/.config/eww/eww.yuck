;; A barra de status mora em bar.yuck, gerado por lua/build.lua a
;; partir dos tokens do "Hyprland Rice Kit". Este arquivo cuida do
;; resto: barra de usuário (usrctl), wifi, menu, calendário e as
;; fontes de dados que os dois lados compartilham.
(include "bar.yuck")

(defvar trayrev false)
(defpoll username :interval "1h" :initial "" "whoami")


(defvar volrev false)
(defvar volico "󰕾")



(defpoll batcap :interval "5s" :initial "0"
    "cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1 | grep . || echo 0"
)


(defvar wifirev false)
(defvar wifihov false)
(defvar wifictlrev false)

(defpoll wifistatus :interval "5s" :initial "{\"icon\": \"󰖪\", \"ssid\": \"Disconnected\", \"strength\": 0}"
    "./scripts/current-wifi.sh"
)

(defwidget wifi []
    (box :class "wifi"
        (eventbox :cursor "pointer"
                  :onhover "./scripts/wifi-delay.sh"
                  :onhoverlost "bash -c '/usr/bin/eww update wifirev=false && /usr/bin/eww update wifihov=false'"
                  :timeout "3s"
                  :onclick "./scripts/wifictl.sh"
                  (box :orientation "h"
                       :space-evenly false
                       (label :text "${wifistatus.icon}")
                       (label :class "space-wifi" :text "\\u00A0")
                       (revealer :reveal {wifirev||wifictlrev?true:false}
                                 :transition "slideright"
                                 :duration "350ms"
                                 (box :class "wifi-type" :space-evenly false
                                      (label :class "wifi-div" :text "|")
                                      (label :limit-width 12 :text "${wifistatus.ssid}")
                                 )
                       )

                  )
        )
    )
)

(defpoll network :interval "3s" 
        "./scripts/getnet.sh"
)

(defwidget wifi_event []
    (eventbox :timeout "3s" :class "shadow-container"
              :onhoverlost "./scripts/wifictl.sh close"
              (box :orientation "v"
                   :space-evenly false
              (box :class "wifictl-container"
                   :space-evenly false
                   :orientation "v"
                   (box :class "wifi-header"
                        :space-evenly false
                        (label :text "Network Manager")
                   )
                   (box :class "wifi-stats"
                        :space-evenly false
                        (label :text "STATUS : ")
                        (label :class "${wifistatus.ssid=="Disconnected"?"nocon":"yescon"}" 
                               :limit-width 27
                               :text  "${wifistatus.ssid=="Disconnected"?" Disconnected":" Connected to ${wifistatus.ssid}"}")
                   )
                   (scroll :vscroll true
                           :class "network-container"
                           (box :orientation "v" :space-evenly false
                                (for i in {network}
                                    (wifi-option :ssid "${i.ssid}" :inuse "${i.in_use}" :auto {i.autoconnect}) 
                                )
                           )
                   )
              )
              (revealer :reveal {wificonfigrev}
                        :transition "slidedown"
                        :duration "350ms"
                        (eventbox :onhoverlost "/usr/bin/eww update wificonfigrev=false"
                                  (box :class "wifictl-container"
                                       :space-evenly false
                                       :orientation "v"
                                       (box :class "swifi-header"
                                            :space-evenly false
                                            (label :text "${wifissidrev}")
                                       )
                                       (box :class "wifi-bcon"
                                            :orientation "h"
                                            :visible {wificlass=="1"?true:false}
                                            (box :class "wifi-buttons"
                                            (button :class "iwifi"
                                                    :height 30
                                                    :tooltip "Digitar a senha no gerenciador de redes"
                                                    :onclick "setsid -f ./scripts/wifi-connect.sh"
                                                    "Conectar…"
                                            ))
                                       )
                                       (box :orientation "h"
                                            :spacing 10
                                            :visible {wificlass=="2"?true:false}
                                            :class "wifi-bcon"
                                            (eventbox :cursor "pointer"
                                                      :height 30
                                                      :class "wifi-buttons"
                                                      :onclick "/usr/bin/eww update wificonfigrev=false && nmcli device wifi connect \"${wifissidrev}\""
                                                      (label :text "Connect")
                                            )
                                            (eventbox :cursor "pointer"
                                                      :class "wifi-buttons"
                                                      :onclick "/usr/bin/eww update wificonfigrev=false && nmcli connection delete \"${wifissidrev}\""
                                                      (label :text "Remove")
                                            )
                                       )
                                       (box :orientation "h"
                                            :spacing 10
                                            :visible {wificlass=="3"?true:false}
                                            :class "wifi-bcon"
                                            (eventbox :cursor "pointer"
                                                      :class "wifi-buttons"
                                                      :onclick "/usr/bin/eww update wificonfigrev=false && ./scripts/wifi-disconnect.sh"
                                                      :height 30
                                                      (label :text "Disconnect")
                                            )
                                            (eventbox :cursor "pointer"
                                                      :class "wifi-buttons"
                                                      :onclick "/usr/bin/eww update wificonfigrev=false && nmcli connection delete \"${wifissidrev}\""
                                                      (label :text "Remove")
                                            )
                                       )
                                  )
                        )
              ))

    )
)

(defvar wificonfigrev false)
(defvar wifissidrev "")
(defvar wificlass "")

(defwidget wifi-option [ssid auto inuse]
    (eventbox :cursor "pointer"
              :onclick "/usr/bin/eww update wificonfigrev=false && /usr/bin/eww update wificonfigrev=true && /usr/bin/eww update wificlass=${auto==false?"1":inuse==false?"2":"3"} && /usr/bin/eww update wifissidrev=\"${ssid}\""
              (box :class "wifi-option-box"
                   :orientation "v"
                   (box :class "wifi-ssid"
                        :space-evenly false
                        :orientation "h"
                        (label :class "${auto==false?"wifi-ssid-01":inuse==false?"wifi-ssid-02":"wifi-ssid-03"}"
                               :limit-width 30 
                               :text "${ssid}"
                        )
                   )
               )
    )
)

(defwindow wifictl
    :monitor 0
    :stacking "overlay"
    :focusable false
    :geometry (geometry :anchor "top right"
                        :x "5px"
                        :y "-14px"
                        :width "425px"
                        :height "1px"
    )
    (box :space-evenly false
              (revealer :transition "slidedown"
                        :reveal wifictlrev
                        :duration "350ms"
                        (wifi_event)
              )
    )
)

(defvar keyrev false)
(defvar keyhov false)

(deflisten kb_layout :initial "EN" "./scripts/get_kb.sh")

(defwidget keyboard []
    (box :class "keyboard"
        (eventbox :onhover "./scripts/kb-delay.sh"
                  :onhoverlost "bash -c '/usr/bin/eww update keyrev=false && /usr/bin/eww update keyhov=false'"
                  :onclick "~/.config/hypr/scripts/kb-switch.sh next"
                  :cursor "pointer"
                  (box :orientation "h"
                       :space-evenly false
                       (label :text "${kb_layout}")
                       (revealer :reveal keyrev
                                 :transition "slideright"
                                 :duration "350ms"
                                 (box :class "kb-type" :space-evenly false
                                      (label :class "kb-div" :text "|")
                                      (label :text "${kb_layout == "EN"?"QWERTY":"Kedmanee"}")
                                 )
                       )
                  )
        )
    )
)

(defwidget button-module [icon cmd ?class ?subclass]
    (box :class "${class}"
         :orientation "h"
         (eventbox :onclick "${cmd}"
                   :cursor "pointer"
                   :class "${subclass}"
                   (label :text "${icon}")
         )
    )
)

(defwidget menu []
    (button-module :class "menu"
                   :subclass "menu-eventbox"
                   :icon " "
                   :cmd "~/.config/eww/scripts/menuctl.sh"
    )
)

(defvar menurev false)

(defwindow menuctl
    :monitor 0
    :stacking "overlay"
    :focusable false
    :geometry (geometry :anchor "top left"
                        :x "5px"
                        :y "-4px"
                        :width "425px"
                        :height "1px")
    (box :space-evenly false
         (revealer :transition "slideright"
                   :reveal menurev
                   :duration "350ms"
                   (menu_event)))
)

(defpoll apps :interval "60s"
    "./scripts/menu.sh"
)

(defwidget menu_event []
    (eventbox :timeout "3s" :class "shadow-container"
              :onhoverlost "./scripts/menuctl.sh close"
              (box :orientation "v"
                   :space-evenly false
                   (box :class "menuctl-container"
                        :space-evenly false
                        :orientation "v"
                        (box :class "menu-header"
                             :space-evenly false
                             (label :text "Program Launcher"))
                        (box :class "menu-subheader"
                             :space-evenly false
                             (label :text ">> Executable List")
                        )
                        (scroll :vscroll true
                                :class "app-container"
                                (box :orientation "v" 
                                     :space-evenly false
                                     (for i in {apps}
                                        (application :name "${i.name}"
                                                     :exec "${i.exec}"
                                                     :icon "${i.icon}"
                                                     :term "${i.terminal}"
                                        )
                                     )
                                     ))))))

(defwidget application [name exec icon term]
    (eventbox :cursor "pointer"
              :onclick "sh -c './scripts/menuctl.sh && cd ~ && ([[ ${term} == true ]] && ghostty -e ${exec} || ${exec}) & disown'"
              (box :class "app-option-box"
                   :orientation "v"
                   (box :class "app-display"
                        :space-evenly false
                        :orientation "h"
                        (box :class "app-ico"
                             :style "background-image:url('${icon}');"
                        )
                        (label :class "app-name" :text "${name}")
                   )
               )
    )
)





(defwindow calendar
    :monitor 0
    :stacking "overlay"
    :focusable false
    :geometry (geometry :anchor "top center"
                        :y "0px"
                        :width "300px"
                        :height "1px"
    )
    (box :class "calendar-window"
         :hexpand true
         :space-evenly false
         :halign "fill"
              (revealer :hexpand true
                        :transition "slidedown"
                        :reveal calrev
                        :duration "350ms"
                        (calendar_event)
              )
    )
)

(defvar calrev false)

(defwidget calendar_event []
    (eventbox :hexpand true
         :timeout "3s" :onhoverlost "./scripts/calendar.sh close"
         (calendar_widget :time get_time
                          :date get_date
         )
    )
)

(defwidget calendar_widget[time date]
    (box :class "calendar-container"
         :hexpand true
         :orientation "v"
         :space-evenly false
         (box :class "clock-card"
              :orientation "v"
              :space-evenly false
              (box :class "time-row"
                   :halign "start"
                   :valign "end"
                   :space-evenly false
                   (label :class "time-digit" :text {substring(time, 0, 2)})
                   (label :class "time-colon" :text ":")
                   (label :class "time-digit" :text {substring(time, 3, 2)})
              )
              (box :class "clock-meta" :hexpand true :space-evenly false
                   (label :class "date-inner" :halign "start" :hexpand true :text date)
              )
         )
         (box :class "cal-card"
              :orientation "v"
              :space-evenly false
              (box :class "cal-head"
                   :space-evenly false
                   (button :class "cal-nav"
                           :cursor "pointer"
                           :onclick "./scripts/calview.sh ${caloffset - 1}"
                           "󰅁")
                   (button :class "cal-title"
                           :hexpand true
                           :cursor "pointer"
                           :tooltip "voltar para o mês atual"
                           :onclick "./scripts/calview.sh 0"
                           "${calview.title}")
                   (button :class "cal-nav"
                           :cursor "pointer"
                           :onclick "./scripts/calview.sh ${caloffset + 1}"
                           "󰅂")
              )
              (box :class "cal-days"
                   :space-evenly true
                   (label :text "dom") (label :text "seg") (label :text "ter")
                   (label :text "qua") (label :text "qui") (label :text "sex")
                   (label :text "sáb")
              )
              (calendar :class "cal ${caloffset == 0 ? "cal-hoje" : "cal-outro"}"
                        :hexpand true
                        :show-heading false
                        :show-day-names false
                        :show-details false
                        :month {calview.month}
                        :year {calview.year}
              )
         )
    )
)

(defvar caloffset 0)
(defvar calview '{"month":1,"year":2026,"title":""}')

(defpoll get_date :interval "1s"
                  "./scripts/caldate.sh"
)

(defpoll get_time :interval "1s"
                  "date +%H:%M:%S"
)


(defpoll get_uptime :interval "1s"
                  "uptime -p"
)

(defwindow usrctl 
    :monitor 0
    :stacking "overlay"
    :focusable false
    :geometry (geometry :anchor "top right"
                        :x "5px"
                        :y "-4px"
                        :width "425px"
                        :height "1px"
    )
    (box :space-evenly false
         :halign "end"
              (revealer :transition "slideleft"
                        :reveal ctlrev
                        :duration "350ms"
                        (usrctl-widget :uptime get_uptime)
              )
    )
)

(defvar ctlrev false)

(defwidget usrctl-widget [uptime]
    (box :space-evenly false
         :valign "start"
    (eventbox :timeout "3s" :class "shadow-container"
         :onhoverlost "./scripts/usrctl.sh close"
         (box :orientation "v"
              :space-evenly false
         (box :class "main-container"
              :orientation "v"
              :halign "center"
              :space-evenly false
              (box :class "profile-container"
                   :space-evenly false
                   (box :class "profile"
                        :space-evenly false
                        :valign "start"
                        :halign "start"
                        (box :class "pfp")
                        (box :class "pfp-text"
                             :orientation "v"
                             :space-evenly false
                             (box :class "username"
                                  :space-evenly false
                                  (label :text username)
                             )
                             (box :class "uptime"
                                  :space-evenly false
                                  (label :limit-width 25 :text "${uptime}")
                             )
                             (box :class "ctlpanel"
                                  (eventbox :cursor "pointer"
                                            :class "shutdown"
                                            :onclick "systemctl poweroff"
                                            :tooltip " Shutdown "
                                            (label :text "⏻")
                                  )
                                  (eventbox :cursor "pointer"
                                            :class "logout"
                                            :onclick "loginctl terminate-user $USER"
                                            :tooltip " Logout "
                                            (label :text "")
                                  )
                                  (eventbox :cursor "pointer"
                                            :class "lockscr"
                                            :onclick "./scripts/lock.sh"
                                            :tooltip " Lock "
                                            (label :text "\\uf023")
                                  )
                                  (eventbox :cursor "pointer"
                                            :class "reboot"
                                            :onclick "systemctl reboot"
                                            :tooltip " Reboot "
                                            (label :text "\\uf021")
                                  )
                                  (eventbox :cursor "pointer"
                                            :class "suspend"
                                            :onclick "systemctl suspend"
                                            :tooltip " Sleep "
                                            (label :text "󰒲")
                                  )
                                  (eventbox :cursor "pointer"
                                            :class "hibernate"
                                            :onclick "systemctl hibernate"
                                            :tooltip " Hibernate "
                                            (label :text "\\uf2dc")
                                  )
                             )
                        )
                   )
              )
              (box :class "monitor-container"
                   :orientation "v"
                   :space-evenly false
                   (box :class "sysctl"
                        :orientation "v"
                        :space-evenly false
                        (box :class "bats"
                             :space-evenly false
                             (box :class "batico-main"
                                  (literal :content batico)
                             )
                             (box :class "bat-detail"
                                  :orientation "v"
                                  (box :class "bat-percent"
                                       :space-evenly false
                                       (label :text "Battery ${batcap}%")
                                  )
                                  (box :class "bat-status"
                                       :space-evenly false
                                       (label :limit-width 26 :text "${batest}")
                                  )
                             )
                        )
                        (box :class "divider-h")
                        (box :class "sys ctlrow"
                            (box :class "ctl-box"
                                 :orientation "v"
                                 :space-evenly false
                                 (eventbox :class "ctl-hover"
                                           :cursor "pointer"
                                           :timeout "3s"
                                           :tooltip "Wi-Fi: clique para ligar/desligar; clique direito para ver redes"
                                           :onclick "setsid -f ./scripts/wifi-radio.sh toggle"
                                           :onrightclick "./scripts/wifictl.sh open"
                                           (box :class "ctlico ${wifi_radio.enabled ? "wifi-on" : "wifi-off"}"
                                                (label :text {wifi_radio.enabled ? "󰖩" : "󰖪"})
                                           )
                                 )
                                 (box :class "ctl-text"
                                      :space-evenly false
                                      :halign "center"
                                      (box :class "ctl01 ${wifi_radio.enabled ? "wifi-on" : "wifi-off"}"
                                        "Wi-Fi "
                                      )
                                      (label :class "ctl02" :text {wifi_radio.enabled ? "On" : "Off"})
                                 )
                            )
                            (box :class "ctl-box"
                                 :orientation "v"
                                 :space-evenly false
                                 (eventbox :class "ctl-hover"
                                           :cursor "pointer"
                                           :tooltip " Bluetooth ${bluetooth.label} - click toggles, right click configures "
                                           :onclick "setsid -f ./scripts/bluetooth.sh toggle"
                                           :onrightclick "${btconfigrev==false?"/usr/bin/eww update btconfigrev=true":"/usr/bin/eww update btconfigrev=false"}"
                                           (box :class "ctlico ${bluetooth.class}"
                                                (label :text "${bluetooth.icon}")
                                           )
                                 )
                                 (box :class "ctl-text"
                                      :space-evenly false
                                      :halign "center"
                                      (box :class "ctl01 ${bluetooth.class}"
                                        "BT "
                                      )
                                      (label :class "ctl02" :limit-width 7 :text "${bluetooth.label}")
                                 )
                            )
                            (box :class "ctl-box"
                                 :orientation "v"
                                 :space-evenly false
                                 (eventbox :class "ctl-hover"
                                           :cursor "pointer"
                                           :tooltip " Power mode ${powerprofile.label} - click to switch "
                                           :onclick "setsid -f ./scripts/powerprofile.sh cycle"
                                           (box :class "ctlico ${powerprofile.class}"
                                                (label :text "${powerprofile.icon}")
                                           )
                                 )
                                 (box :class "ctl-text"
                                      :space-evenly false
                                      :halign "center"
                                      (box :class "ctl01 ${powerprofile.class}"
                                        "MODE "
                                      )
                                      (label :class "ctl02" :limit-width 7 :text "${powerprofile.short}")
                                 )
                            )
                        )
                        (revealer :transition "slidedown"
                                  :duration "350ms"
                                  :reveal btconfigrev
                                  (box :class "btctl-container"
                                       :orientation "v"
                                       :space-evenly false
                                       (box :class "btctl-header"
                                            :space-evenly false
                                            (label :hexpand true :halign "start" :text "${btscanning == true ? "Scanning..." : "Bluetooth Devices"}")
                                            (eventbox :cursor "pointer"
                                                      :class "bt-scan"
                                                      :tooltip " Scan for devices "
                                                      :onclick "setsid -f ./scripts/bluetooth.sh scan"
                                                      (label :text "󰑐")
                                            )
                                       )
                                       (box :class "btctl-empty"
                                            :visible {bluetooth.count == 0}
                                            (label :text "${bluetooth.powered == false ? "Bluetooth is off" : btscanning == true ? "Looking for devices..." : "No devices yet - hit scan"}")
                                       )
                                       (box :orientation "v"
                                            :space-evenly false
                                            (for d in btdevices
                                                 (bt-device :mac {d.mac} :name {d.name} :icon {d.icon} :connected {d.connected})
                                            )
                                       )
                                  )
                        )
                        (box :class "divider-h")
                        (box :class "sys"
                            (box :class "cpu-box" 
                                 :orientation "v" 
                                 :space-evenly false
                                 (eventbox :class "cpu-hover"
                                           :tooltip " ${round(EWW_CPU.avg,1)}% used "
                                           (circular-progress :class "cpu"
                                                    :value {round(EWW_CPU.avg,10)}
                                                    :thickness 5
                                                    (box :class "cpuico"
                                                        (label :text " ")
                                                    )
                                           )
                                 )
                                 (box :class "cpu-text"
                                      :space-evenly false
                                      :halign "center"
                                      (box :class "cpu01"
                                        "CPU "
                                      )
                                      (box :class "cpu02"
                                        "${round(EWW_CPU.avg,0)}%"
                                      )
                                 )
                            )
                            (box :class "ram-box" 
                                 :orientation "v" 
                                 :space-evenly false
                                 (eventbox :class "ram-hover"
                                           :tooltip " ${round(EWW_RAM.used_mem/1073741824,1)}GB used "
                                           (circular-progress :class "ram"
                                                    :value {round(EWW_RAM.used_mem_perc,10)}
                                                    :thickness 5
                                                    (box :class "ramico"
                                                         (label :text " ")
                                                    )
                                           )
                                 )
                                 (box :class "ram-text"
                                      :space-evenly false
                                      :halign "center"
                                      (box :class "ram01"
                                        "RAM "
                                      )
                                      (box :class "ram02"
                                        "${round(EWW_RAM.used_mem_perc,0)}%"
                                      )
                                 )
                            )
                            (box :class "disk-box"
                                 :orientation "v" 
                                 :space-evenly false 
                                 (eventbox :class "disk-hover"
                                           :tooltip " ${round(EWW_DISK["/"].used/1073741824,1)}GB used "
                                           (circular-progress :class "disk"
                                                    :value {round(EWW_DISK["/"].used_perc,10)}
                                                    :thickness 5
                                                    (box :class "diskico"
                                                         (label :text " ")
                                                    )
                                           )
                                 )
                                 (box :class "disk-text"
                                      :space-evenly false
                                      :halign "center"
                                      (box :class "disk01"
                                        "DISK "
                                      )
                                      (box :class "disk02"
                                        "${round(EWW_DISK["/"].used_perc,0)}%"
                                      )
                                 )
                            )
                        )
                        (box :class "sliderctl"
                             :orientation "v"
                             :spacing 15
                             (box :class "volume-slider"
                                  :space-evenly false
                                  :halign "center"
                                  (label :text {tn_volmute ? "󰖁" : get_vol >= 50 ? "󰕾" : get_vol > 0 ? "󰖀" : "󰕿"})
                                  (scale :class "vol"
                                         :value get_vol
                                         :max 101 
                                         :min 0
                                         :round-digits 0
                                         :onchange "pamixer --set-volume {}"
                                  )
                             )
                             (box :class "light-slider"
                                  :space-evenly false
                                  :halign "center"
                                  (label :text "")
                                  (scale :value get_light
                                         :class "lig"
                                         :max 101 
                                         :min 1
                                         :round-digits 0
                                         :onchange "brightnessctl set {}%"
                                  )
                             )
                        )
                   )
              )
         )
         (music-player)
         (box :class "notifications-container"
              :orientation "v"
              :space-evenly false
              (box :class "notifications-header"
                   :space-evenly false
                   (label :class "notifications-title"
                          :hexpand true
                          :halign "start"
                          :text "Notificações")
                   (box :class "notification-actions"
                        :space-evenly false
                        :spacing 8
                        (eventbox :class "notification-action notification-dnd ${notifications.dnd ? "notification-dnd-active" : ""}"
                                  :cursor "pointer"
                                  :tooltip {notifications.dnd ? "Desativar não perturbe" : "Ativar não perturbe"}
                                  :onclick "./scripts/notifications.sh toggle-dnd"
                                  (label :text {notifications.dnd ? "" : ""}))
                        (eventbox :class "notification-action notification-clear"
                                  :cursor "pointer"
                                  :tooltip "Limpar histórico"
                                  :onclick "./scripts/notifications.sh clear"
                                  (label :text "󰆴"))
                   )
              )
              (box :class "notifications-empty"
                   :visible {notifications.count == 0}
                   (label :text "Nenhuma notificação recente"))
              (scroll :class "notifications-scroll"
                      :vscroll true
                      :hscroll false
                      :height 210
                      :visible {notifications.count > 0}
                      (box :orientation "v" :space-evenly false
                           (for n in {notifications.items}
                                (box :class "notification-card notification-${n.urgency}"
                                     :orientation "v"
                                     :space-evenly false
                                     (label :class "notification-app"
                                            :halign "start"
                                            :limit-width 38
                                            :text "${n.app}")
                                     (label :class "notification-summary"
                                            :halign "start"
                                            :limit-width 38
                                            :text "${n.summary}")
                                     (label :class "notification-body"
                                            :halign "start"
                                            :limit-width 42
                                            :wrap true
                                            :text "${n.body}")))))
         )
         )
    ))
)

(defvar btconfigrev false)
(defvar btscanning false)

(defpoll notifications :interval "2s" :initial "{\"count\":0,\"dnd\":false,\"items\":[]}"
    "./scripts/notifications.sh status"
)

(defpoll wifi_radio :interval "3s" :initial "{\"enabled\":false}"
    "./scripts/wifi-radio.sh"
)

(defpoll bluetooth :interval "3s" :initial "{\"powered\": false, \"icon\": \"󰂲\", \"label\": \"Off\", \"class\": \"bt-off\", \"count\": 0}"
    "./scripts/bluetooth.sh"
)

(defpoll btdevices :interval "5s" :initial "[]"
    "./scripts/bluetooth.sh devices"
)

(defwidget bt-device [mac name icon connected]
    (eventbox :cursor "pointer"
              :class "bt-device-row"
              :tooltip "${connected == true ? " Click to disconnect " : " Click to connect "} - right click removes "
              :onclick "setsid -f ./scripts/bluetooth.sh ${connected == true ? "disconnect" : "connect"} ${mac}"
              :onrightclick "setsid -f ./scripts/bluetooth.sh remove ${mac}"
              (box :space-evenly false
                   (label :class "bt-device-ico ${connected == true ? "bt-conn" : "bt-off"}"
                          :text "${icon}")
                   (label :class "${connected == true ? "bt-device-on" : "bt-device-off"}"
                          :halign "start" :limit-width 24 :text "${name}")
              )
    )
)

(defpoll powerprofile :interval "2s" :initial "{\"profile\": \"balanced\", \"icon\": \"󰾅\", \"label\": \"Balanced\", \"short\": \"Bal\", \"class\": \"pp-balanced\"}"
    "./scripts/powerprofile.sh"
)
(deflisten batico "./scripts/batico.sh")
(deflisten batest "./scripts/batest.sh")
(defpoll media :interval "1s"
    :initial '{"available":false,"hasArt":false,"player":"","title":"","artist":"","thumbnail":"","status":"Stopped","length":0,"position":0,"progress":0,"lengthStr":"0:00","positionStr":"0:00"}'
    "./scripts/media.sh status"
)

(defpoll get_light :interval "1s" :initial "1" "./scripts/brightness.sh")

(defpoll get_vol :interval "1s" :initial "0" "pamixer --get-volume 2>/dev/null || echo 0")

(defpoll coretemp :interval "2s" :initial "{\"package\":0,\"cores\":[]}"
    "./scripts/coretemp.sh"
)

(defwidget music-player []
    (revealer :transition "slidedown"
                   :reveal {media.available}
         (box :class "music-container"
              :space-evenly false
              :orientation "h"
              (box :class "music-thumbnail ${media.hasArt ? "has-art" : "no-art"}"
                   :style {media.hasArt ? "background-image: url('${media.thumbnail}');" : ""}
                   (label :class "music-art-placeholder" :text {media.hasArt ? "" : "art"})
              )
              (box :class "music-body"
                   :orientation "v"
                   :space-evenly false
                   :hexpand true
                   (label :class "main-title" :halign "start" :xalign 0 :limit-width 31 :text "${media.title}")
                   (label :class "artist" :halign "start" :xalign 0 :limit-width 38 :text "${media.artist}")
                   (progress :class "music-slider" :value {media.progress})
                   (box :class "music-footer"
                        :orientation "h"
                        :space-evenly false
                        (box :class "music-action"
                             :orientation "h"
                             :space-evenly false
                             :spacing 14
                             (eventbox :class "mico" :cursor "pointer" :tooltip "Anterior" :onclick "./scripts/media.sh previous" "󰒮")
                             (eventbox :class "mico media-seek media-seek-back" :cursor "pointer" :tooltip "Voltar 10 segundos" :onclick "./scripts/media.sh seek-backward"
                                       (image :path "./scripts/media-seek.svg" :image-width 17 :image-height 17))
                             (eventbox :class "mico media-play" :cursor "pointer" :tooltip {media.status == "Playing" ? "Pausar" : "Reproduzir"} :onclick "./scripts/media.sh play-pause" {media.status == "Playing" ? "󰓛" : "󰐊"})
                             (eventbox :class "mico media-seek" :cursor "pointer" :tooltip "Avançar 10 segundos" :onclick "./scripts/media.sh seek-forward"
                                       (image :path "./scripts/media-seek.svg" :image-width 17 :image-height 17))
                             (eventbox :class "mico" :cursor "pointer" :tooltip "Próxima" :onclick "./scripts/media.sh next" "󰒭")
                        )
                        (label :class "music-timer" :hexpand true :halign "end" :text "${media.positionStr} / ${media.lengthStr}")
                   )
              )
         ))

)

(include "shortcuts.yuck")
